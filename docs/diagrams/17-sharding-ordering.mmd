flowchart TB
    %% Design view: partition key to virtual shard, lease ownership, and per-key ordering.
    classDef proc fill:#eff6ff,stroke:#1d4ed8,color:#172554
    classDef store fill:#fefce8,stroke:#a16207,color:#422006
    classDef core fill:#f5f3ff,stroke:#6d28d9,color:#2e1065
    classDef failure fill:#fef2f2,stroke:#dc2626,color:#7f1d1d
    classDef note fill:#f8fafc,stroke:#334155,color:#0f172a
    classDef pending fill:#fff7ed,stroke:#c2410c,color:#431407

    Env["EventEnvelope"]:::proc
    Key["key = tenant_id + ':' + partition_key"]:::core
    Hash["fnv32a key"]:::core
    Mod["shard = hash % 4096"]:::core
    Env --> Key --> Hash --> Mod

    subgraph Ownership["shard_leases table"]
        Acquire["Acquire shard, owner, ttl<br/>insert only if expired"]:::proc
        Renew["Renew with matching fencing_token"]:::proc
        Release["Release on shutdown"]:::proc
        Expired["Lease expired<br/>token increments on takeover"]:::failure
        L[(shard_leases)]:::store
        Acquire --> L
        Renew --> L
        Release --> L
        L --> Expired
    end

    Mod --> Acquire
    Expired -.->|split brain is rejected| Renew

    Order["Same partition key maps to the same shard,<br/>so one owner processes that key in order."]:::note
    Acquire --> Order

    subgraph Status["Current wiring"]
        S1["domain.VirtualShard, ports.ShardLeaseRepository<br/>and migrations/006 exist"]:::note
        S2["cmd/worker does not filter subjects by shard yet,<br/>so ordering is per broker consumer, not per owner"]:::pending
        S3["See roadmap: bounded concurrency per shard"]:::pending
    end
