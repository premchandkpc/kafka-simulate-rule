{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flowrule.io/schemas/rule-set-v1.json",
  "title": "FlowRule Rule Set",
  "type": "object",
  "required": ["rule_set", "revision", "mode", "rules"],
  "additionalProperties": false,
  "properties": {
    "rule_set": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "mode": {
      "type": "string",
      "enum": ["first_match", "all_matches"]
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "priority", "when", "then"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "when": { "$ref": "#/$defs/predicate" },
        "then": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/action" }
        },
        "otherwise": {
          "type": "array",
          "maxItems": 10,
          "items": { "$ref": "#/$defs/action" }
        }
      }
    },
    "predicate": {
      "type": "object",
      "oneOf": [
        { "$ref": "#/$defs/compositePredicate" },
        { "$ref": "#/$defs/leafPredicate" }
      ]
    },
    "compositePredicate": {
      "type": "object",
      "required": ["all", "any", "not"],
      "additionalProperties": false,
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/predicate" }
        },
        "any": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/$defs/predicate" }
        },
        "not": { "$ref": "#/$defs/predicate" }
      }
    },
    "leafPredicate": {
      "type": "object",
      "required": ["path", "op"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\$(\\.[a-zA-Z_][a-zA-Z0-9_]*)*(\\[\\d+\\])*$"
        },
        "op": {
          "type": "string",
          "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "in", "not_in", "exists", "not_exists"]
        },
        "value": {}
      }
    },
    "action": {
      "type": "object",
      "oneOf": [
        { "$ref": "#/$defs/emitAction" },
        { "$ref": "#/$defs/commandAction" }
      ]
    },
    "emitAction": {
      "type": "object",
      "required": ["emit"],
      "additionalProperties": false,
      "properties": {
        "emit": {
          "type": "object",
          "required": ["topic", "data"],
          "additionalProperties": false,
          "properties": {
            "topic": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[a-z][a-z0-9.-]*[a-z0-9]$"
            },
            "data": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    },
    "commandAction": {
      "type": "object",
      "required": ["command"],
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "object",
          "required": ["destination", "name", "data"],
          "additionalProperties": false,
          "properties": {
            "destination": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
            },
            "data": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    }
  }
}