{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flowrule.io/schemas/event-envelope-v1.json",
  "title": "FlowRule Event Envelope",
  "type": "object",
  "required": ["id", "type", "tenant_id", "partition_key", "occurred_at", "data"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[0-9A-Za-z_-]+$"
    },
    "type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9.]*[a-z0-9]$"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$"
    },
    "partition_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "additionalProperties": true
    },
    "headers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}