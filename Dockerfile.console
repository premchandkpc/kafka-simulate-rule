# Build the React console, then serve static assets and proxy private services via Docker DNS.
FROM node:26-alpine AS builder
WORKDIR /repo/web/console
COPY web/console/package.json ./
RUN npm install --no-audit --no-fund
COPY web/console/ ./
COPY domains/ /repo/domains/
RUN npm run build

FROM nginx:1.28-alpine
COPY web/console/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /repo/web/console/dist /usr/share/nginx/html
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --retries=5 CMD wget -q -O - http://127.0.0.1:8080/healthz >/dev/null || exit 1
