# Go worker build
FROM golang:1.26-alpine AS go-builder
RUN apk add --no-cache git make
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /worker ./cmd/worker

# Rust alternative runtime build. Kept separate from the Go source/runtime.
FROM rust:alpine AS rust-builder
RUN apk add --no-cache musl-dev
WORKDIR /app
COPY rust-worker/Cargo.toml ./Cargo.toml
COPY rust-worker/src ./src
RUN cargo build --release
RUN cp target/release/flowrule-rust-worker /worker-rust

# Runtime image contains both binaries; entrypoint chooses exactly one.
FROM alpine:3.24
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=go-builder /worker ./worker
COPY --from=go-builder /app/migrations ./migrations
COPY --from=rust-builder /worker-rust ./worker-rust
COPY deploy/worker-entrypoint.sh ./worker-entrypoint.sh

ENV WORKER_RUNTIME=go \
    APP_ENV=production \
    LOG_LEVEL=info \
    SHUTDOWN_TIMEOUT=30s \
    MIGRATIONS_DIR=/app/migrations \
    NUM_SHARDS=4096 \
    MAX_GLOBAL_IN_FLIGHT=100 \
    MAX_PER_KEY_QUEUE=100 \
    KEY_QUEUE_WORKERS=1 \
    BATCH_MODE=none \
    BATCH_MAX=100 \
    BATCH_WINDOW_MS=30000 \
    SCHEDULER_POLL_MS=5000 \
    SCHEDULER_BATCH_SIZE=100 \
    LEASE_TTL_MS=30000 \
    LEASE_RENEWAL_INTERVAL_MS=10000

ENTRYPOINT ["./worker-entrypoint.sh"]
