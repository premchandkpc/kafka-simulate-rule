# FlowRule Docker Compose configuration
# Copy to .env; these values use Docker DNS names and are intended for Compose.

# Application
APP_ENV=development
LOG_LEVEL=info
HTTP_ADDR=:8080
SHUTDOWN_TIMEOUT=30s

# Production tenant identity: configure only when API is behind a trusted auth proxy.
# Proxy must strip inbound X-Proxy-Auth / X-Authenticated-Tenant-ID and set them itself.
# Non-development APP_ENV fails closed unless this secret is configured.
FLOWRULE_TRUSTED_PROXY_TOKEN=

# Database (PostgreSQL)
STORAGE_BACKEND=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=flowrule
DATABASE_URL=postgres://postgres:postgres@postgres:5432/flowrule?sslmode=disable
MIGRATIONS_DIR=/app/migrations

# MongoDB (optional, for alternative persistence)
MONGODB_URI=
MONGODB_DATABASE=

# NATS JetStream
NATS_URL=nats://nats:4222
NATS_STREAM=flowrule
NATS_CONSUMER=
NATS_ACK_WAIT_MS=30000
NATS_MAX_DELIVER=10

# Opt-in random-producer example (only used with --profile simulation)
RANDOM_PRODUCER_CLIENTS=10
RANDOM_PRODUCER_MESSAGES_MAX=100
RANDOM_PRODUCER_CONCURRENCY=16

# Redis (optional, for caching/distributed locking)
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Worker & Scheduling
NUM_SHARDS=4096
# Compose starts three worker replicas by default. Keep this aligned with the Compose replica count.
WORKER_REPLICAS=3
WORKER_ID=
MAX_GLOBAL_IN_FLIGHT=100
FETCH_BATCH_SIZE=100
EFFECT_PUBLISH_INTERVAL_MS=5000
EFFECT_PUBLISH_BATCH_SIZE=10
EVENT_RETRY_DELAY_MS=5000
MAX_PER_KEY_QUEUE=100
KEY_QUEUE_WORKERS=1
EFFECT_DESTINATION_URL=
HOT_KEY_THRESHOLD=1000
HOT_KEY_CHECK_INTERVAL_MS=10000
BATCH_MODE=none
BATCH_MAX=100
BATCH_WINDOW_MS=30000
SCHEDULER_POLL_MS=5000
SCHEDULER_BATCH_SIZE=100
LEASE_TTL_MS=30000
LEASE_RENEWAL_INTERVAL_MS=10000

# Authentication. Production must configure either JWT auth or a trusted proxy token.
# Set REQUIRE_AUTH=true and a JWT_SECRET of at least 32 characters for first-party JWT auth.
JWT_SECRET=
JWT_ISSUER=flowrule
JWT_AUDIENCE=flowrule-api
REQUIRE_AUTH=false
REQUIRED_SCOPES=

# Code Generation
PROTOC_PATH=protoc
PROTOC_GEN_GO_PATH=protoc-gen-go
PROTOC_GEN_GO_GRPC_PATH=protoc-gen-go-grpc
GENERATION_OUTPUT_DIR=/generated
# Local Compose service ports (published on host loopback only)
COMPOSE_PROJECT_NAME=flowrule
CONSOLE_PORT=3000
API_PORT=8080
POSTGRES_PORT=5432
NATS_PORT=4222
NATS_MONITOR_PORT=8222
REDIS_PORT=6379

# Private worker metrics listener; console proxies it on the same origin
FLOWRULE_METRICS_ADDR=:9090
FLOWRULE_CONSOLE_ORIGIN=http://localhost:3000
