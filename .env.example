# FlowRule Configuration
# Copy to .env for local development (do not commit secrets)

# Application
APP_ENV=development
LOG_LEVEL=info
HTTP_ADDR=:8080
GRPC_ADDR=:9090
SHUTDOWN_TIMEOUT=30s

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/flowrule?sslmode=disable
MIGRATIONS_DIR=migrations

# MongoDB (optional, for alternative persistence)
MONGODB_URI=
MONGODB_DATABASE=

# NATS JetStream
NATS_URL=nats://localhost:4222
NATS_STREAM=flowrule
NATS_CONSUMER=

# Redis (optional, for caching/distributed locking)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Worker & Scheduling
NUM_SHARDS=4096
WORKER_ID=
MAX_GLOBAL_IN_FLIGHT=100
MAX_PER_KEY_QUEUE=100
KEY_QUEUE_WORKERS=1
BATCH_MODE=none
BATCH_MAX=100
BATCH_WINDOW_MS=30000
SCHEDULER_POLL_MS=5000
SCHEDULER_BATCH_SIZE=100
LEASE_TTL_MS=30000
LEASE_RENEWAL_INTERVAL_MS=10000

# Code Generation
PROTOC_PATH=protoc
PROTOC_GEN_GO_PATH=protoc-gen-go
PROTOC_GEN_GO_GRPC_PATH=protoc-gen-go-grpc
GENERATION_OUTPUT_DIR=